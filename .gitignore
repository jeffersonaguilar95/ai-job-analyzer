# IDE
.idea/

# Extension build artifacts
extension/node_modules/
extension/dist/

# Stray root-level installs — there's no package.json at the repo root,
# so these only show up if `yarn`/`npm install` is run from the wrong dir
/node_modules/
/yarn.lock

# Go service
matching-service/bin/
matching-service/.env
matching-service/matching-service

# Secrets and personal data — never commit these
**/*.env
claude_api_key*
cv.pdf
*.cv.pdf

# resources/ holds personal files dropped in locally (CV today, more later).
# Folder structure is tracked via .gitkeep; actual file contents are not.
resources/**
!resources/**/
!resources/**/.gitkeep

# Exported results (contain personal matching data)
job-matches.*

# Chrome profile scripts/start.sh launches for the extension — not your
# regular Chrome profile, but still local browser state, never committed
/.chrome-profile/
