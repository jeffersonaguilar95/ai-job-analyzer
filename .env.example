# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.
# scripts/start.sh loads .env automatically; anything you already have
# exported in your shell takes precedence over what's in here.

# Required.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — path to your CV PDF. Leave unset to auto-detect the single PDF
# in resources/cv/ instead.
# CV_PATH=/absolute/path/to/your-cv.pdf

# Optional — defaults shown.
# PORT=8787
# ANTHROPIC_MODEL=claude-opus-5

# Optional — path to a Chrome/Chromium binary, if scripts/start.sh can't
# find it at the usual macOS install location.
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
